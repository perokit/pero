{
  "name": "@perokit/pero",
  "version": "0.26.0",
  "description": "Open-source Personal Agent Runtime for running an always-on AI assistant on your VPS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perokit/pero.git"
  },
  "homepage": "https://github.com/perokit/pero#readme",
  "bugs": {
    "url": "https://github.com/perokit/pero/issues"
  },
  "type": "module",
  "bin": {
    "pero": "./bin/pero.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^22.17.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start -- --foreground --workspace .",
    "start:dev": "nest start --watch -- --foreground --workspace .",
    "start:debug": "nest start --debug --watch -- --foreground --workspace .",
    "start:prod": "node dist/daemon/main.js --foreground",
    "cli": "node bin/pero.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:smoke": "vitest run --config ./vitest.config.smoke.ts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "npm run build && PERO_WORKSPACE=${PERO_WORKSPACE:-.} typeorm migration:generate -d dist/persistence/data-source.js",
    "migration:run": "npm run build && PERO_WORKSPACE=${PERO_WORKSPACE:-.} typeorm migration:run -d dist/persistence/data-source.js",
    "migration:show": "npm run build && PERO_WORKSPACE=${PERO_WORKSPACE:-.} typeorm migration:show -d dist/persistence/data-source.js",
    "migration:revert": "npm run build && PERO_WORKSPACE=${PERO_WORKSPACE:-.} typeorm migration:revert -d dist/persistence/data-source.js",
    "prepack": "npm run build",
    "pretest:e2e": "npm run build",
    "pretest:smoke": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@inquirer/prompts": "8.7.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/typeorm": "12.0.1",
    "@openai/codex-sdk": "0.158.0",
    "better-sqlite3": "12.11.1",
    "croner": "10.0.1",
    "grammy": "1.46.0",
    "nest-commander": "3.21.0",
    "pino": "10.3.1",
    "playwright": "1.64.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tar": "7.5.22",
    "typeorm": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "@golevelup/nestjs-discovery": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
